# Copy this file, name the copy ".env", and fill in your own keys.
# Never share your .env file or post your secret key anywhere.

# Stripe > Developers > API keys. Use the sk_test_ key while testing,
# then swap to the sk_live_ key when you're ready to take real money.
STRIPE_SECRET_KEY=sk_test_replace_me

# Optional: Stripe > Developers > Webhooks > add endpoint
#   https://your-domain.com/api/stripe-webhook  (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# Optional: your public web address once the site is online
SITE_URL=
